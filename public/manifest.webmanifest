{
  "id": "com.bilo.app",
  "name": "bilo - Developer Project Manager",
  "short_name": "bilo",
  "description": "Minimalist developer project management and task focus app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#06b6d4",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/favicon.ico",
      "sizes": "256x256 128x128 64x64 48x48 32x32 16x16",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Today Focus",
      "url": "/",
      "icons": [{ "src": "/bilo-icon-light.png", "sizes": "192x192" }]
    },
    {
      "name": "Kanban Board",
      "url": "/",
      "icons": [{ "src": "/bilo-icon-light.png", "sizes": "192x192" }]
    }
  ]
}